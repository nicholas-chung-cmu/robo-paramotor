      <freejoint name="pod_free"/>
      <site name="pod_com" size="0.004" rgba="1 0 1 1"/>

      <!-- Merged airframe block 205.2 g: frame 65 + PCB 68.2 + battery 65 + risers 3 + guides 4. One uniform box cannot reproduce the CG or inertia of the parts it replaces; mass is exact, distribution is not. -->
      <geom name="airframe_block" class="block" type="box"
            pos="0.0100 0.0000 0.0260"
            size="0.07000 0.04500 0.04200"
            mass="0.140200" rgba="0.38 0.42 0.48 0.85"/>
      <site name="imu" pos="0.030 0 0.048" size="0.003" rgba="0 1 1 1"/>

      <!-- Battery, kept as its own block: slide it fore/aft to trim CG. -->
      <geom name="battery_block" class="block" pos="0.010 0 -0.020"
            size="0.02800 0.01500 0.00800"
            mass="0.065000" rgba="0.75 0.20 0.15 1"/>

      <!-- Motor: SunnySky X2204-1800KV, pusher. Outrunner can is a cylinder about the shaft, not a box. -->
      <geom name="motor_can" type="cylinder" pos="-0.0980 0 0.010"
            size="0.01400 0.01300" euler="0 1.5707963 0"
            mass="0.019600" rgba="0.20 0.20 0.24 1"/>

      <!-- Thrust and propeller reaction torque act on the airframe at the propeller location. Attaching this actuator site to the free rotor applies drag torque to prop_spin and reverses its commanded speed. -->
