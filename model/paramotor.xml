        <site name="bl_start_L" pos="0.0400 0 0" size="0.0020"
              rgba="0.9 0.1 0.1 1"/>
      </body>

      <!-- - STEERING CHANNEL R  -->
      <geom name="servo_R" class="block" pos="-0.0200 -0.0400 0.0520"
            size="0.01450 0.01500 0.00600"
            mass="0.011800" rgba="0.15 0.18 0.55 1"/>

      <!-- Servo arm on the output face, swinging about y: the shaft axis follows the case when the servo is laid flat. The brake line is anchored at the arm tip. -->
      <body name="arm_R" pos="-0.0200 -0.0590 0.0520"
            euler="0 -1.808190 0">
        <joint name="arm_R" type="hinge" axis="0 1 0" damping="0.0015"
               armature="5.00e-05" frictionloss="0.0008"
