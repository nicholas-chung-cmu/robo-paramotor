<mujoco model="paramotor_scene">
  <!-- Generated by build_paramotor.py - do not hand-edit; edit the generator. -->
  <include file="paramotor.xml"/>

    <!-- CRITICAL: znear and zfar are MULTIPLES of stat.extent, and the terrain drags the auto-computed extent from ~1 m to ~256 m. That pushes the near clip plane out to ~2.6 m and the whole aircraft disappears whenever the camera is closer than that. Pin the extent to the aircraft. -->
    <statistic extent="1.0" center="0 0 0.3"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <map znear="0.005" zfar="400"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.62 0.86"
             rgb2="0.10 0.14 0.24" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.22 0.29 0.21"
             rgb2="0.27 0.35 0.25" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="60 60" texuniform="true"
             reflectance="0.02"/>
    <material name="rock" rgba="0.40 0.42 0.38 1" reflectance="0.02"/>
    <!-- Ships flat: MuJoCo allocates zeros when no file is given. make_terrain() in view_paramotor.py fills it procedurally at load. -->
    <hfield name="terrain" nrow="96" ncol="96"
            size="90.0 90.0 12.0 1.0"/>
  </asset>

  <worldbody>
    <!-- Directional, not a local lamp: a positional light at the origin leaves the rig unlit once it flies away from it. -->
    <light directional="true" pos="0 0 10" dir="-0.3 -0.4 -1"
           diffuse="0.9 0.9 0.85" specular="0.2 0.2 0.2"/>
    <!-- Ground and mountains give the parallax needed to see motion. -->
    <geom name="ground" type="plane" size="0 0 0.05" pos="0 0 -18.0"
          material="grid" contype="0" conaffinity="0"/>
    <geom name="mountains" type="hfield" hfield="terrain" pos="0 0 -18.0"
          material="rock" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
